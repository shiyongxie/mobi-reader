{
  "name": "Mobi Reader · 本地电子书阅读器",
  "short_name": "MobiReader",
  "description": "纯前端的电子书阅读器（MOBI / EPUB），支持语音朗读与标注，数据全部保存在本地 IndexedDB。",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f7f9",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": [
            "application/epub+zip",
            ".epub",
            "application/x-mobipocket-ebook",
            ".mobi",
            ".prc"
          ]
        }
      ]
    }
  }
}
